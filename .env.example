# local-claude-code configuration via environment variables

# Model name (must be available on the server)
# LCC_MODEL=qwen2.5-coder:14b

# OpenAI-compatible API base URL
# LCC_BASE_URL=http://localhost:11434/v1

# API key (most local servers don't need one)
# LCC_API_KEY=

# Permission mode: "ask" (prompt before writes) or "auto" (allow all)
# LCC_PERMISSION_MODE=ask

# Maximum input tokens for context window
# LCC_MAX_INPUT_TOKENS=16000
